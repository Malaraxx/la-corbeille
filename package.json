{
  "name": "la-corbeille",
  "version": "3.14.0",
  "description": "Simulateur de gestion de patrimoine au tour par tour, de 2026 à 2076, dans un monde inventé à chaque partie.",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node tools/build.mjs",
    "check": "node tools/build.mjs --check",
    "test": "node tools/build.mjs --check && node tests/run.mjs",
    "test:full": "node tests/run.mjs --full",
    "balance": "node tests/run.mjs --balance",
    "e2e": "node tests/e2e.mjs",
    "monde": "node tools/monde.mjs",
    "build:s4": "node saison4/tools/build.mjs",
    "check:s4": "node saison4/tools/build.mjs --check",
    "test:s4": "node saison4/tools/build.mjs --check && node saison4/tests/run.mjs",
    "balance:s4": "node saison4/tests/run.mjs --balance",
    "e2e:s4": "node saison4/tests/e2e.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {}
}
